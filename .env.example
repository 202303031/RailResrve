# ------------------------------------------------------------------
# RailReserve configuration. Copy this file to `.env` and adjust.
# `.env` is git-ignored so real secrets are never committed.
# ------------------------------------------------------------------

# --- PostgreSQL (read by docker-compose) ---
POSTGRES_DB=railreserve
POSTGRES_USER=railreserve
POSTGRES_PASSWORD=railreserve
# Host port for Postgres (container is always 5432). Defaults to 5433 in compose since 5432 is
# frequently already taken locally.
POSTGRES_PORT=5433

# --- Service ports exposed by docker-compose ---
BACKEND_PORT=8080
FRONTEND_PORT=5173

# --- Backend datasource (read by the Spring app when run outside Docker) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/railreserve
SPRING_DATASOURCE_USERNAME=railreserve
SPRING_DATASOURCE_PASSWORD=railreserve
SERVER_PORT=8080

# --- JWT authentication (used from Phase 6) ---
JWT_SECRET=change-me-to-a-long-random-value-at-least-32-bytes
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600
